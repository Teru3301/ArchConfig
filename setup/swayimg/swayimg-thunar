#!/bin/bash
# Открывает всю папку, даже если выбрано 1 изображение

# Получаем путь к выбранному файлу
selected_file="$1"

# Если файл не передан — выходим
if [[ -z "$selected_file" ]]; then
    echo "Ошибка: не указан файл!"
    exit 1
fi

# Получаем папку, где лежит файл
dir_path=$(dirname "$selected_file")

# Запускаем swayimg для ВСЕХ изображений в этой папке
swayimg "$dir_path"/*
