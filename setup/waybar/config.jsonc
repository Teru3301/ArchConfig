
//  сайт с иконками
//  https://www.w3schools.com/icons/google_icons_action.asp

{
    // Основные настройки
    "layer": "top",
    "height": 22, // Тонкая панель
    "spacing": 5, // Минимальные отступы

    // Порядок блоков
    "modules-left": ["custom/cpu-load", "custom/cpu-temp", "custom/nvidia-load", "custom/gpu-temp", "memory", "disk#home"/*, "mpris"*/],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["tray", "custom/usb", "backlight", "pulseaudio", "hyprland/language", "battery", /*"custom/keyboard-layout",*/ "custom/clock"],


    "custom/usb": {
        "format": "", // Иконка USB (FontAwesome)
        "tooltip": true,
        "exec": "~/.config/waybar/scripts/usb-status.sh",
        "on-click": "~/.config/waybar/scripts/usb-menu.sh",
        "interval": 5
    },


    // Настройки модулей
    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "default": "{name}", // Неактивный workspace
            "active": "{name}",   // Активный workspace
            "urgent": "{name}!"  // Workspace с уведомлением
        },
        "on-click": "activate", // Переключение на workspace при клике
        "active-only": false
    },

    "cpu": {
        "format": "{usage}%  ",
        "tooltip": false,
        "interval": 1,
        "format-alt": "CPU: {usage}%",
        "states": {
            "warning": 70, // Предупреждение при нагрузке > 70%
            "critical": 90 // Критическое состояние при нагрузке > 90%
        }
    },

    "custom/cpu-load": {
        "exec": "~/.config/waybar/scripts/cpu-load.sh",
        "interval": 1,
        "format": "{}%  ",
        "tooltip": false,
	"states": {
            "warning": 40, // Предупреждение при нагрузке > 70%
            "critical": 85 // Критическое состояние при нагрузке > 90%
        }
    },

    "custom/cpu-temp": {
        "exec": "~/.config/waybar/scripts/cpu-temperature.sh",
        "interval": 5,
        "format": "{}   ",
        "tooltip": false,
	"states": {
            "warning": 60, // Предупреждение при нагрузке > 70%
            "critical": 85 // Критическое состояние при нагрузке > 90%
        }
    },

    "custom/nvidia-load": {
        "exec": "~/.config/waybar/scripts/nvidia-gpu-load.sh",
        "interval": 2,
        "format": "{text}%  ",
        "return-type": "text",
	"states": {
		"warning": 40
	}
        //"format-icons": [" "],       //     󰢮       󰘷   󰵉    
    },

    "custom/gpu-temp": {
        "exec": "~/.config/waybar/scripts/nvidia-gpu-temperature.sh",
        "interval": 5,
        "format": "{}  ",  // или любой другой значок, например: 󰢮
        "tooltip": false,
	"states": {
            "warning": 50,
            "critical": 85 
        }
    },


    "disk#home": {
        "format": " {used}/{total}",
        "path": "/"
    },

    "memory": {
        "format": "{}%   ", // ",
        "interval": 5,
        "states": {
            "warning": 70, // Предупреждение при использовании > 70%
            "critical": 90 // Критическое состояние при использовании > 90%
        }
    },

    "temperature": {
        "critical-threshold": 80, // Критическая температура
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "states": {
            "critical": 80 // Критическое состояние при температуре > 80°C
        }
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠",
        "states": {
            "disconnected": true // Подсветка при отключении сети
        }
    },

    "mpris": {
        "format": "▶  {artist} - {title}",
        "format-paused": "⏸  {artist} - {title}",
        "format-stopped": "⏹",
        "format-disconnected": "Sound: Disconnected",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "max-length": 30,
        "min-length": 30
    },

    "custom/playerctl": {   //  тоже самое что mpris
        "interval": 1,
        "exec": "~/.config/waybar/scripts/playerctl.sh",
        "max-length": 30,
        "min-length": 30,
        "return-type": "json"
    },

    "pulseaudio": {
        "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", "", "", "", "", "", "", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30, // Предупреждение при заряде < 30%
            "critical": 15 // Критическое состояние при заряде < 15%
        },
        "format": "{capacity}% {icon}  ",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/clock": {
        "exec": "date '+%e %B  %H:%M'",
        "interval": 60,
        "tooltip": false
    },


    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>",
        "tooltip": true,
        "format": "{locale}: {:%B %d %H:%M}"
//        "format": "{:%B %e  %H:%M}"
    },

    "tray": {
        "spacing": 5
    },

//    "custom/keyboard-layout": {
//        "exec": "~/.config/waybar/keyboard-layout.sh",
//        "interval": 1,
//        "format": "{}",
//        "return-type": "json"
//    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "tooltip": true
    },

    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["💡"]   // "○", "◉", "●"   ...   "", ""   💡  󰍹 
    }
}
