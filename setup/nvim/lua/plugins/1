-- ~/.config/nvim/lua/plugins/treesitter.lua
return {
  "nvim-treesitter/nvim-treesitter",
  build = ":TSUpdate",
  event = { "BufReadPost", "BufNewFile" },
  dependencies = {
    "nvim-treesitter/nvim-treesitter-textobjects",  -- Текстовые объекты
    "windwp/nvim-ts-autotag",                      -- Автозакрытие тегов
    "JoosepAlviste/nvim-ts-context-commentstring", -- Умные комментарии
  },
  config = function()
    require("nvim-treesitter.configs").setup({
      -- Основные модули
      ensure_installed = {
        "lua", "python", "javascript", "typescript", "html",
        "css", "json", "yaml", "bash", "markdown"
      },
      highlight = {
        enable = true,
        disable = { "help" },  -- Отключить для help-файлов
      },
      indent = { enable = true },
      incremental_selection = {
        enable = true,
        keymaps = {
          init_selection = "gnn",
          node_incremental = "grn",
          scope_incremental = "grc",
          node_decremental = "grm",
        },
      },

      -- Настройки textobjects
      textobjects = {
        select = {
          enable = true,
          lookahead = true,
          keymaps = {
            ["af"] = "@function.outer",
            ["if"] = "@function.inner",
            ["ac"] = "@class.outer",
            ["ic"] = "@class.inner",
          },
        },
      },

      -- Автозакрытие тегов (для HTML/XML)
      autotag = {
        enable = true,
        filetypes = { "html", "xml", "javascript", "typescriptreact" },
      },

      -- Умные комментарии
      context_commentstring = {
        enable = true,
        enable_autocmd = false,
      },
    })

    -- Дополнительные настройки для языков
    vim.treesitter.language.register('markdown', 'mdx')  -- MDX как markdown
  end
}
